# Sheela bot environment variables
#
# Locally: copy this file to .env and fill in real values.
# On the VM: values come from /home/sheela/.config/sheela.env, injected by
# the systemd EnvironmentFile directive — pydantic-settings reads them from
# os.environ and ignores any local .env.

# LLM (loaded but unused in Step 1; loading early surfaces config errors at startup)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=4096

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Vault
VAULT_REPO_PATH=/home/sheela/vault

# Operational paths
SHEELA_DATA_DIR=/home/sheela/data
SHEELA_LOG_DIR=/home/sheela/logs
SHEELA_DB_PATH=/home/sheela/data/sheela.db
SHEELA_TZ=America/New_York

# Set SHEELA_DEBUG=1 for verbose logs
SHEELA_DEBUG=0
