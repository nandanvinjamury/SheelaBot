# Sheela bot environment variables
#
# Locally: copy this file to .env and fill in real values.
# On the VM: values come from /home/sheela/.config/sheela.env, injected by
# the systemd EnvironmentFile directive — pydantic-settings reads them from
# os.environ and ignores any local .env.

# LLM provider — gemini (default), anthropic (fallback), ollama_local (future).
# Stubs only in Step 1; gemini gets a real implementation in Step 2.
LLM_PROVIDER=gemini

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic — optional fallback. Leave blank unless you've explicitly
# switched LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Vault
VAULT_REPO_PATH=/home/sheela/vault

# Channel routing config — lives outside the repo so edits survive deploys.
# deploy/deploy.sh seeds it from deploy/routing.yaml.example on first deploy.
SHEELA_ROUTING_PATH=/home/sheela/.config/sheela-routing.yaml

# Operational paths
SHEELA_DATA_DIR=/home/sheela/data
SHEELA_LOG_DIR=/home/sheela/logs
SHEELA_DB_PATH=/home/sheela/data/sheela.db
SHEELA_TZ=America/New_York

# Logging
# console = pretty colored output to stderr (local dev default)
# file    = JSON to {SHEELA_LOG_DIR}/sheela.log + JSON to stderr (VM/systemd)
SHEELA_LOG_MODE=console
SHEELA_LOG_LEVEL=INFO
SHEELA_DEBUG=0
